cloudFunctions
{
    /*
    Difference from the usual file:

    The ParticlePostProcessing blocks below are the standard patch-hit outputs.
    The extra trajectoryByDistance block records the in-flight trajectory itself
    at a fixed displacement interval.  It can be used together with the usual
    patch outputs; it does not change the particle motion.

    Output:
        postProcessing/lagrangian/<cloud>/trajectoryByDistance/<startTime>/
            distanceTrajectory.dat

    Main columns:
        parcelId sample particleAge x y z distance Ux Uy Uz d typeId event

    event is one of:
        initial   first recorded point for the parcel
        distance  point written after moving another interval [m]
        patch     final patch-hit point, if writeOnPatch is true
    */
    trajectoryByDistance
    {
        type          distanceTrajectory;
        interval      1e-4;   // [m] distance between trajectory samples
        writeInitial  true;   // write the injection/first-seen position
        writeOnPatch  true;   // also write final wall/outlet hit positions
    }

    outletParticles
    {
        type              particlePostProcessing;
        log               true;
        maxStoredParcels  1e7;
        executeControl    timeStep;
        executeInterval   1;
        writeControl      writeTime;
        writeInterval     1;
        patches (outlet);
    }
    

    wallSubstrateParticles
    {
