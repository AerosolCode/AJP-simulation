# main: 手動BO用。site.envへコピーし、計算を実行するhostで設定します。
# site.envはGit管理外。SSH login名は各自のsshコマンドで指定してください。
# AJP_* の単純な KEY=value（export可）のみ。$HOMEや先行変数を利用できます。
export AJP_PYTHON_BIN=python3
export AJP_OPENFOAM_BASHRC=/usr/lib/openfoam/openfoam2406/etc/bashrc

# 空欄ならOpenFOAM環境のPATHからaerosolDynamicsFoamを探します。
export AJP_PARTICLE_SOLVER=""
# 空欄ならSlurmにnode選択を任せます。必要なら計算node名を指定。
export AJP_SLURM_NODELIST=""
# 通常は空欄。別のworker-env.shを使う場合だけ絶対pathを指定。
export AJP_WORKER_ENV=""
