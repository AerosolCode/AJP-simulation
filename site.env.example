# Copy this file to site.env and edit it once for each cluster user.
# 利用者ごとにsite.envへコピーし、SSH userとpathを編集してください。
# site.env is intentionally ignored by Git / site.envはGit管理外です。

export AJP_MASTER_PYTHON=python3

# SSH login names may differ between hosts.
# SSHのログイン名がhostごとに異なる場合も個別に指定できます。
export AJP_SSH_USER_XEON1=student_xeon1
export AJP_SSH_USER_XEON4=student_xeon4
export AJP_SSH_USER_XEON5=student_xeon5

# Worker areas may also differ between hosts. These values must be absolute.
# worker領域もhostごとに絶対pathで指定します。
export AJP_WORKER_ROOT_XEON6="$HOME/AJP-worker"
export AJP_WORKER_ROOT_XEON1="/home/$AJP_SSH_USER_XEON1/AJP-worker"
export AJP_WORKER_ROOT_XEON4="/home/$AJP_SSH_USER_XEON4/AJP-worker"
export AJP_WORKER_ROOT_XEON5="/home/$AJP_SSH_USER_XEON5/AJP-worker"
